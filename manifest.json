{
  "manifest_version": 3,
  "name": "feature-creep",
  "version": "0.1.0",
  "description": "Adds a ✨ Suggest Feature button to GitHub repos that files the most plausible pointless feature request.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.anthropic.com/*",
    "https://hn.algolia.com/*"
  ],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["extension/content.js"],
      "css": ["extension/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extension/aardvark_button1.png",
        "extension/aardvark_button2.png",
        "extension/aardvark-desk.png",
        "extension/aardvark-launcher.png",
        "extension/mascot-arrow.png",
        "extension/popup-art/*.png"
      ],
      "matches": ["https://github.com/*"]
    }
  ],
  "options_ui": {
    "page": "extension/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "feature-creep: set API keys"
  }
}
